{
  "name": "@toolbox/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env dev",
    "deploy": "pnpm --filter @toolbox/web build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply toolbox --local --env dev",
    "db:migrate:remote": "wrangler d1 migrations apply toolbox --remote",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run",
    "keys": "node scripts/generate-keys.mjs",
    "types": "wrangler types --env-interface CloudflareBindings src/worker-configuration.d.ts"
  },
  "dependencies": {
    "@toolbox/shared": "workspace:*",
    "hono": "^4.13.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260922.1",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.136.3"
  }
}
