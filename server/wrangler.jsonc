{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "toolbox",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],

  // The website (web/dist) is served by this same Worker, so the API and
  // the site share one origin — the refresh cookie never crosses sites.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "toolbox",
      // Replace with the id printed by `wrangler d1 create toolbox`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // Installers and dependency packages.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "toolbox-files" }],

  // Transactional e-mail (verification, password reset). Requires the
  // sender domain to be onboarded: `wrangler email sending enable <domain>`.
  // Without it (local dev) e-mails are only logged.
  // "send_email": [{ "name": "EMAIL" }],

  "vars": {
    "ENVIRONMENT": "production",
    // Public URL of the site (links in e-mails, desktop login page).
    "WEB_BASE_URL": "https://toolbox.example.com",
    "EMAIL_FROM": "nao-responda@toolbox.example.com",
    // Accounts created/logging in with these e-mails become admins.
    "ADMIN_EMAILS": ""
  },
  // Secrets (never in this file) — `wrangler secret put <NAME>`:
  //   JWT_SECRET                 random ≥ 32 bytes, signs access tokens
  //   DOWNLOAD_SIGNING_KEY       random ≥ 32 bytes, signs download links
  //   ENTITLEMENT_PRIVATE_KEY    Ed25519 PKCS#8 (base64), signs the plan
  //                              token the desktop app verifies
  // `pnpm --filter @toolbox/server keys` generates all three.

  // Housekeeping: expired codes, tokens, sessions, rate-limit rows.
  "triggers": { "crons": ["17 3 * * *"] },

  "observability": { "enabled": true },

  "env": {
    "dev": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "toolbox",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "toolbox-files" }],
      "vars": {
        "ENVIRONMENT": "development",
        "WEB_BASE_URL": "http://localhost:5173",
        "EMAIL_FROM": "nao-responda@localhost",
        "ADMIN_EMAILS": ""
      }
    }
  }
}
